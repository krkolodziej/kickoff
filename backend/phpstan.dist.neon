parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by the framework as an IDE aid, not written by anybody and not application
        # code. Its docblock declares a type alias naming one config class per enabled bundle,
        # and those classes are generated per environment into var/cache/<env>/Symfony/Config
        # — so whether this file analyses cleanly depends on which caches happen to be warm.
        # A check whose result depends on that answers a question nobody asked.
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
